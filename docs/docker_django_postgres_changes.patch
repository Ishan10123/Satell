diff --git a/django_app/compose.yaml b/django_app/compose.yaml
new file mode 100644
--- /dev/null
+++ b/django_app/compose.yaml
@@ -0,0 +1,47 @@
+services:
+  django:
+    build:
+      context: ..
+      dockerfile: django_app/Dockerfile
+    environment:
+      DJANGO_SECRET_KEY: ${DJANGO_SECRET_KEY:?Set DJANGO_SECRET_KEY in the environment}
+      DJANGO_DEBUG: ${DJANGO_DEBUG:-0}
+      DJANGO_ALLOWED_HOSTS: ${DJANGO_ALLOWED_HOSTS:-localhost,127.0.0.1}
+      DJANGO_DB_ENGINE: postgresql
+      POSTGRES_DB: ${POSTGRES_DB:?Read POSTGRES_DB from the existing rag-postgres container}
+      POSTGRES_USER: ${POSTGRES_USER:?Read POSTGRES_USER from the existing rag-postgres container}
+      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?Read POSTGRES_PASSWORD from the existing rag-postgres container}
+      POSTGRES_HOST: postgres
+      POSTGRES_PORT: "5432"
+      POSTGRES_CONNECT_TIMEOUT: "5"
+      POSTGRES_TEST_DB: ${POSTGRES_TEST_DB:-rag_django_test_20261118}
+      RAG_ADAPTER: mock
+      DJANGO_SECURE_COOKIES: "0"
+      DJANGO_SECURE_SSL_REDIRECT: "0"
+    ports:
+      - "127.0.0.1:${DJANGO_HOST_PORT:-8001}:8000"
+    networks:
+      - rag-app-network
+    read_only: true
+    tmpfs:
+      - /tmp:size=32m,mode=1777
+    init: true
+    security_opt:
+      - no-new-privileges:true
+    cap_drop:
+      - ALL
+    healthcheck:
+      test:
+        - CMD
+        - python
+        - -c
+        - "from urllib.request import urlopen; urlopen('http://127.0.0.1:8000/accounts/login/', timeout=2).read()"
+      interval: 30s
+      timeout: 3s
+      retries: 3
+      start_period: 10s
+
+networks:
+  rag-app-network:
+    name: rag-app-network
+    external: true
