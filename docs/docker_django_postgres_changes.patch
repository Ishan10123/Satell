diff --git a/django_app/Dockerfile b/django_app/Dockerfile
new file mode 100644
--- /dev/null
+++ b/django_app/Dockerfile
@@ -0,0 +1,19 @@
+FROM python:3.13-slim
+
+ENV PYTHONDONTWRITEBYTECODE=1 \
+    PYTHONUNBUFFERED=1 \
+    PIP_DISABLE_PIP_VERSION_CHECK=1
+
+WORKDIR /app
+
+COPY django_app/requirements-docker.txt /tmp/requirements.txt
+RUN python -m pip install --no-cache-dir -r /tmp/requirements.txt \
+    && groupadd --system --gid 10001 django \
+    && useradd --system --uid 10001 --gid django --home-dir /app --no-create-home django
+
+COPY --chown=django:django django_app/ /app/
+
+USER django
+EXPOSE 8000
+
+CMD ["python", "manage.py", "runserver", "0.0.0.0:8000", "--noreload"]
