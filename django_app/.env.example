# Copy to .env only for a fresh local setup. Keep the existing .env when reusing
# the current rag-postgres, rag-api, and authorization configuration.
DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_HOST_PORT=8001
DJANGO_SECURE_COOKIES=0
DJANGO_SECURE_SSL_REDIRECT=0

# Password recovery. Configure a real SMTP server before remote deployment.
# For local development only, EMAIL_BACKEND may explicitly be set to
# django.core.mail.backends.console.EmailBackend while DJANGO_DEBUG=1.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=1
SMTP_USE_SSL=0
SMTP_FROM_NAME=Satell
SMTP_FROM_EMAIL=no-reply@example.invalid
SMTP_TIMEOUT_SECONDS=10
PUBLIC_APP_BASE_URL=http://127.0.0.1:8001
PASSWORD_RESET_TIMEOUT_SECONDS=3600
PASSWORD_RESET_RATE_LIMIT=5
PASSWORD_RESET_RATE_WINDOW_SECONDS=3600

# These must match the existing PostgreSQL container; do not reset its volume.
POSTGRES_DB=rag_application
POSTGRES_USER=replace-with-existing-postgres-user
POSTGRES_PASSWORD=replace-with-existing-postgres-password
POSTGRES_TEST_DB=rag_django_test

# This must match the private FastAPI service credential.
RAG_API_TOKEN=replace-with-the-existing-private-rag-api-token
RAG_API_TIMEOUT_SECONDS=120
RAG_API_TOP_K=8

# Use the already configured local academic demo only when its signed registry
# is enabled and validated. Production mode stays fail-closed by default.
RAG_AUTHORIZATION_MODE=production
RAG_LOCAL_ACADEMIC_DEMO_ENABLED=0
RAG_TENANT_ID=local
RAG_PRINCIPAL_ID=local-admin
RAG_EVALUATION_DIAGNOSTICS_ENABLED=0
